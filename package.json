{
  "name": "kitsu-season-trends",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Daily Kitsu seasonal anime trends",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun scripts/prepare-data.ts && bun --bun run nuxt dev",
    "generate": "bun scripts/prepare-data.ts && bun --bun run nuxt generate",
    "build": "bun run generate && bun scripts/verify-static.ts",
    "preview": "bun scripts/serve-static.ts",
    "typecheck": "bun scripts/prepare-data.ts && bun --bun run nuxt typecheck",
    "test": "bun test tests/unit",
    "test:browser": "playwright test",
    "check:http": "bun scripts/check-static-http.ts",
    "cron": "bun cron/index.ts",
    "backfill:posters": "bun scripts/backfill-posters.ts",
    "backfill:history": "bun scripts/backfill-history.ts",
    "backfill:stats": "bun scripts/backfill-stats.ts"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.3",
    "@tabler/icons-vue": "3.49.0",
    "json5": "2.2.3",
    "kitsu-native": "13.0.0",
    "msgpack-lite": "0.1.26",
    "nuxt": "4.5.2",
    "nuxt-charts": "3.1.0",
    "vue": "3.5.43",
    "wilson-rate": "1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.2",
    "@types/msgpack-lite": "0.1.12",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.5"
  },
  "overrides": {
    "nitropack": "2.13.4",
    "kitsu-core": "13.0.0"
  },
  "patchedDependencies": {
    "nuxt-charts@3.1.0": "patches/nuxt-charts@3.1.0.patch"
  }
}
